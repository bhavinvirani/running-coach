# Every environment variable the app reads, with values that work for local development.
# Local: copy to .env (git-ignored). Production: set the same names on Render with real secrets;
# never reuse these dev values there. apps/api/src/lib/config.ts validates all of them at boot.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origin the browser uses; CORS and auth cookies are locked to it. Dev: the Vite server.
APP_URL=http://localhost:5173

# Local docker compose Postgres. On Render: Neon's direct (non-pooler) connection string,
# because advisory locks and migrations need a real session.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/running_coach
# Integration tests: admin connection; a migrated template is cloned into one database per test file.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/running_coach_test
# e2e: apps/web/playwright.config.ts starts its own API on port 4173 with fake secrets, Garmin fixtures and
# the runner in apps/web/e2e/fixtures/seed.ts, and ignores this file. Export this in the shell to point
# pnpm test:e2e and test:screens at another database; the default is below.
# E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/running_coach_e2e

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Garmin tokens and Claude keys; losing it loses them.
MASTER_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-better-auth-secret-not-for-production
# Shared secret between the API and the Garmin service it spawns. Optional: a random one is made per boot.
GARMIN_SERVICE_SECRET=
GARMIN_SERVICE_PORT=8765
# 1 serves services/garmin/tests/fixtures instead of calling Garmin (CI and e2e).
GARMIN_FIXTURES=0
# GitHub Actions sends this to the daily sync endpoint (slice 5). openssl rand -hex 32
CRON_SECRET=dev-only-cron-secret

# The coach. Each user's own Claude key (stored encrypted) pays for the calls; no server key exists.
# The fallback model takes the one retry after an overloaded or failing call.
COACH_MODEL=claude-opus-5-5
COACH_FALLBACK_MODEL=claude-sonnet-5-5
# Per-call timeout in ms. Leave CLAUDE_BASE_URL empty: only tests point it at a local fake.
CLAUDE_TIMEOUT_MS=60000
CLAUDE_BASE_URL=

# The owner account. pnpm seed:owner reads these; on Render, set them once and the next boot creates the owner.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Public Mapbox token (pk.), URL-restricted, used at web build time (slice 3).
VITE_MAPBOX_TOKEN=
