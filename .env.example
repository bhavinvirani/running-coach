# Phase 2 spikes (spikes/garmin). Copy to .env and fill in. .env is git-ignored.
# The password is used once by `uv run login.py` to obtain tokens. Leave it blank to be prompted instead.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Local Postgres started by `docker compose up -d` in spikes/garmin (spike 3).
SPIKE_DATABASE_URL=postgresql://postgres:spike@localhost:5433/postgres
