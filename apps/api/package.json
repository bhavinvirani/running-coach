{
  "name": "@running-coach/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "seed:owner": "tsx --env-file-if-exists=../../.env src/scripts/seed-owner.ts",
    "coach:eval": "tsx --env-file-if-exists=../../.env src/scripts/coach-eval.ts",
    "fake:claude": "tsx test/fake-claude-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@running-coach/engine": "workspace:*",
    "@running-coach/shared": "workspace:*",
    "better-auth": "1.7.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
