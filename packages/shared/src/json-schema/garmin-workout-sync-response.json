{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tokenBundle": {
      "type": "string",
      "minLength": 2
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "move",
              "remove",
              "unschedule"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "done",
              "gone",
              "failed",
              "skipped"
            ]
          },
          "workoutId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "scheduleId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ref",
          "action",
          "outcome",
          "workoutId",
          "scheduleId"
        ],
        "additionalProperties": false
      }
    },
    "stopped": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "validation",
                "unauthorized",
                "not_found",
                "rate_limited",
                "internal",
                "garmin_not_connected",
                "garmin_auth_expired",
                "garmin_rate_limited",
                "garmin_unavailable",
                "garmin_mfa_required",
                "claude_key_missing",
                "claude_key_invalid",
                "claude_unavailable",
                "plan_missing",
                "session_locked"
              ]
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "calendar": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scheduleId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "workoutId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "scheduleId",
              "workoutId",
              "date",
              "title"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tokenBundle",
    "results",
    "stopped",
    "calendar"
  ],
  "additionalProperties": false
}
