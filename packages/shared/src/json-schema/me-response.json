{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "name"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "enum": [
            "km",
            "mi"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "coachDetail": {
          "type": "string",
          "enum": [
            "short",
            "standard",
            "detailed"
          ]
        },
        "hasClaudeKey": {
          "type": "boolean"
        }
      },
      "required": [
        "units",
        "timezone",
        "coachDetail",
        "hasClaudeKey"
      ],
      "additionalProperties": false
    },
    "garmin": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_connected",
            "ok",
            "expired"
          ]
        },
        "lastSyncAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "lastSyncAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "user",
    "settings",
    "garmin"
  ],
  "additionalProperties": false
}
