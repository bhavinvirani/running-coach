                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "zone",
                        "distanceM",
                        "durationS"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "repeat",
                  "steps"
