                    "type": "integer",
                    "minimum": 2,
                    "maximum": 50
                  },
                  "steps": {
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "warmup",
                            "run",
                            "work",
                            "recovery",
                            "cooldown"
                          ]
                        },
                        "zone": {
                          "type": "string",
                          "enum": [
                            "easy",
                            "marathon",
                            "threshold",
                            "interval",
                            "repetition",
                            "race"
                          ]
                        },
                        "distanceM": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 100000
