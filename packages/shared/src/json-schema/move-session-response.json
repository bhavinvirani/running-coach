                      {
                        "type": "null"
                      }
                    ]
                  },
                  "durationS": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 21600
                      },
                      {
                        "type": "null"
                      }
                    ]
