        },
        "type": {
          "type": "string",
          "enum": [
            "easy",
            "intervals",
            "tempo",
            "long",
            "race_practice",
            "race",
            "strength",
            "rest"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "distanceM": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durationS": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "zone": {
              "anyOf": [
                {
                  "type": "string",
