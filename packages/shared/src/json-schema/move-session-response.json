                  "kind": {
                    "type": "string",
                    "enum": [
                      "warmup",
                      "run",
                      "work",
                      "recovery",
                      "cooldown"
                    ]
                  },
                  "zone": {
                    "type": "string",
                    "enum": [
                      "easy",
                      "marathon",
                      "threshold",
                      "interval",
                      "repetition",
                      "race"
                    ]
