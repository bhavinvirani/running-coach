                    "title": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "planned",
                        "done",
                        "missed",
                        "moved",
                        "skipped"
                      ]
                    },
                    "target": {
                      "type": "object",
                      "properties": {
                        "distanceM": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
