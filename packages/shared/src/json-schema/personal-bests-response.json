{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "distanceKey": {
            "type": "string",
            "enum": [
              "1k",
              "1mi",
              "2mi",
              "5k",
              "5mi",
              "10k",
              "15k",
              "10mi",
              "20k",
              "half",
              "marathon"
            ]
          },
          "timeS": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "activityId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "startUtc": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "startLocal": {
            "type": "string",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z)|(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?)$"
          }
        },
        "required": [
          "distanceKey",
          "timeS",
          "activityId",
          "startUtc",
          "startLocal"
        ],
        "additionalProperties": false
      }
    },
    "garmin": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "distanceKey": {
                    "type": "string",
                    "enum": [
                      "1k",
                      "1mi",
                      "2mi",
                      "5k",
                      "5mi",
                      "10k",
                      "15k",
                      "10mi",
                      "20k",
                      "half",
                      "marathon"
                    ]
                  },
                  "timeS": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "achievedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  }
                },
                "required": [
                  "distanceKey",
                  "timeS",
                  "achievedAt"
                ],
                "additionalProperties": false
              }
            },
            "fetchedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "records",
            "fetchedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checking": {
      "type": "boolean"
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "validation",
            "unauthorized",
            "not_found",
            "rate_limited",
            "internal",
            "garmin_not_connected",
            "garmin_auth_expired",
            "garmin_rate_limited",
            "garmin_unavailable",
            "garmin_mfa_required",
            "claude_key_missing",
            "claude_key_invalid",
            "claude_unavailable",
            "plan_missing",
            "session_locked"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "bests",
    "garmin",
    "pendingRuns",
    "checking",
    "errorCode"
  ],
  "additionalProperties": false
}
