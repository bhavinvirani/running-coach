{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "easy",
        "intervals",
        "tempo",
        "long",
        "race_practice",
        "race",
        "strength",
        "rest"
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "done",
        "missed",
        "moved",
        "skipped"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "distanceM": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "zone": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "easy",
                "marathon",
                "threshold",
                "interval",
                "repetition",
                "race"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "distanceM",
        "durationS",
        "zone"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "target"
  ],
  "additionalProperties": false
}
