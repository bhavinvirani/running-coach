{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "move",
        "remove",
        "unschedule"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "done",
        "gone",
        "failed",
        "skipped"
      ]
    },
    "workoutId": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "scheduleId": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ref",
    "action",
    "outcome",
    "workoutId",
    "scheduleId"
  ],
  "additionalProperties": false
}
