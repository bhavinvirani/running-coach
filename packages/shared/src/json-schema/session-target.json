{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "distanceM": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "durationS": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "zone": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "easy",
            "marathon",
            "threshold",
            "interval",
            "repetition",
            "race"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "distanceM",
    "durationS",
    "zone"
  ],
  "additionalProperties": false
}
