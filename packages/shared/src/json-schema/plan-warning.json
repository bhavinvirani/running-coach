{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "race_date_close"
        },
        "weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "minimumWeeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "weeks",
        "minimumWeeks"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "no_recent_runs"
        },
        "startVolumeM": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "startVolumeM"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "long_run_short"
        },
        "peakLongRunM": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "requiredLongRunM": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "peakLongRunM",
        "requiredLongRunM"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "target_time_ambitious"
        },
        "targetTimeS": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "predictedTimeS": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "targetTimeS",
        "predictedTimeS"
      ],
      "additionalProperties": false
    }
  ]
}
