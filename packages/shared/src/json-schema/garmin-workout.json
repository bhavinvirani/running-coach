{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "estimatedDurationS": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "warmup",
                  "interval",
                  "recovery",
                  "cooldown"
                ]
              },
              "distanceM": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationS": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pace": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "fastSPerKm": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "slowSPerKm": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "fastSPerKm",
                      "slowSPerKm"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "distanceM",
              "durationS",
              "pace"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "repeat": {
                "type": "integer",
                "minimum": 2,
                "maximum": 9007199254740991
              },
              "steps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "warmup",
                        "interval",
                        "recovery",
                        "cooldown"
                      ]
                    },
                    "distanceM": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "durationS": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "pace": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "fastSPerKm": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            },
                            "slowSPerKm": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "fastSPerKm",
                            "slowSPerKm"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "distanceM",
                    "durationS",
                    "pace"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "repeat",
              "steps"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "name",
    "estimatedDurationS",
    "steps"
  ],
  "additionalProperties": false
}
