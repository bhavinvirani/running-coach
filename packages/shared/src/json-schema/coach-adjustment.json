{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "none",
        "scale",
        "easy",
        "rest"
      ]
    },
    "factor": {
      "type": [
        "number",
        "null"
      ]
    },
    "nextStep": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "factor",
    "nextStep"
  ],
  "additionalProperties": false
}
