{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tokenBundle": {
      "type": "string",
      "minLength": 2
    },
    "detail": {
      "type": "object",
      "properties": {
        "laps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "distanceM": {
                "type": "number",
                "minimum": 0
              },
              "durationS": {
                "type": "number",
                "minimum": 0
              },
              "avgHr": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "avgCadence": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "index",
              "distanceM",
              "durationS",
              "avgHr",
              "avgCadence"
            ],
            "additionalProperties": false
          }
        },
        "streams": {
          "type": "object",
          "properties": {
            "elapsedS": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "distanceM": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "hr": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "cadence": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "elevationM": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "speedMps": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "elapsedS",
            "distanceM",
            "hr",
            "cadence",
            "elevationM",
            "speedMps"
          ],
          "additionalProperties": false
        },
        "route": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "hrZones": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "zone": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "lowBpm": {
                    "type": "number",
                    "minimum": 0
                  },
                  "seconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "zone",
                  "lowBpm",
                  "seconds"
                ],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "laps",
        "streams",
        "route",
        "hrZones"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "tokenBundle",
    "detail"
  ],
  "additionalProperties": false
}
