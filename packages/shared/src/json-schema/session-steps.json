{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "warmup",
              "run",
              "work",
              "recovery",
              "cooldown"
            ]
          },
          "zone": {
            "type": "string",
            "enum": [
              "easy",
              "marathon",
              "threshold",
              "interval",
              "repetition",
              "race"
            ]
          },
          "distanceM": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "durationS": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "zone",
          "distanceM",
          "durationS"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "repeat": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "warmup",
                    "run",
                    "work",
                    "recovery",
                    "cooldown"
                  ]
                },
                "zone": {
                  "type": "string",
                  "enum": [
                    "easy",
                    "marathon",
                    "threshold",
                    "interval",
                    "repetition",
                    "race"
                  ]
                },
                "distanceM": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "durationS": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "zone",
                "distanceM",
                "durationS"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "repeat",
          "steps"
        ],
        "additionalProperties": false
