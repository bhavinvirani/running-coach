{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "loginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mfaCode": {
      "type": "string",
      "pattern": "^\\d{4,10}$"
    }
  },
  "required": [
    "loginId",
    "mfaCode"
  ],
  "additionalProperties": false
}
