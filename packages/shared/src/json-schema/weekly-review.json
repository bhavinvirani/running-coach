{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "whatHappened": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "whatItMeans": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "nextWeek": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  },
  "required": [
    "headline",
    "whatHappened",
    "whatItMeans",
    "nextWeek"
  ],
  "additionalProperties": false
}
