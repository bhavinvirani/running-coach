{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "kind": {
      "type": "string",
      "enum": [
        "scale",
        "easy",
        "rest"
      ]
    },
    "factor": {
      "type": [
        "number",
        "null"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "session",
    "kind",
    "factor",
    "note"
  ],
  "additionalProperties": false
}
