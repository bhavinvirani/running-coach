{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "whatHappened": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "whatItMeans": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "nextWeek": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "changes": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "kind": {
            "type": "string",
            "enum": [
              "scale",
              "easy",
              "rest"
            ]
          },
          "factor": {
            "type": [
              "number",
              "null"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "session",
          "kind",
          "factor",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "headline",
    "whatHappened",
    "whatItMeans",
    "nextWeek",
    "changes"
  ],
  "additionalProperties": false
}
