{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "garminActivityId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "gone",
        "failed"
      ]
    },
    "elapsedS": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "distanceM": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "required": [
    "garminActivityId",
    "outcome",
    "elapsedS",
    "distanceM"
  ],
  "additionalProperties": false
}
