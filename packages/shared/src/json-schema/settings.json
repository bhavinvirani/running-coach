{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "units": {
      "type": "string",
      "enum": [
        "km",
        "mi"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "coachDetail": {
      "type": "string",
      "enum": [
        "short",
        "standard",
        "detailed"
      ]
    },
    "hasClaudeKey": {
      "type": "boolean"
    },
    "coachCredential": {
      "type": "string",
      "enum": [
        "key",
        "plan",
        "none"
      ]
    },
    "claudePlanAvailable": {
      "type": "boolean"
    }
  },
  "required": [
    "units",
    "timezone",
    "coachDetail",
    "hasClaudeKey",
    "coachCredential",
    "claudePlanAvailable"
  ],
  "additionalProperties": false
}
