{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "race",
            "fitness"
          ]
        },
        "distanceKey": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "5k",
                "10k",
                "half",
                "marathon"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "raceDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetTimeS": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "daysPerWeek": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        },
        "longRunDay": {
          "type": "string",
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ]
        },
        "recentTime": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "distanceKey": {
                  "type": "string",
                  "enum": [
                    "1k",
                    "1mi",
                    "2mi",
                    "5k",
                    "5mi",
                    "10k",
                    "15k",
                    "10mi",
                    "20k",
                    "half",
                    "marathon"
                  ]
                },
                "timeS": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "distanceKey",
                "timeS"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "distanceKey",
        "raceDate",
        "targetTimeS",
        "daysPerWeek",
        "longRunDay",
        "recentTime"
      ],
      "additionalProperties": false
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "weeklyVolumesM": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "longestRunM": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "daysSinceLastRun": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "weeklyVolumesM",
        "longestRunM",
        "daysSinceLastRun"
      ],
      "additionalProperties": false
    },
    "vdotSource": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "enum": [
                "entered",
                "race",
                "best_effort"
              ]
            },
            "distanceM": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "timeS": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "activityId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "origin",
            "distanceM",
            "timeS",
            "activityId",
            "date"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "goal",
    "startDate",
    "baseline",
    "vdotSource"
  ],
  "additionalProperties": false
}
